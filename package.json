{
  "name": "dsh-ruankao-essay",
  "version": "0.1.0",
  "private": true,
  "description": "软考系统分析师论文助手：题库查询 + 10 段式写作与 Word 交付（two skills: ruankao-essay-writing, ruankao-essay-bank）",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "meta": {
    "title": "软考系分论文助手",
    "description": "题库索引 + 10 段式论文写作、改写与 Word 交付"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets/ruankao-essay-bank/SKILL.md",
    "assets/ruankao-essay-bank/references/topic-index-lite.md",
    "assets/ruankao-essay-writing/SKILL.md",
    "assets/ruankao-essay-writing/references/writing-rules.md",
    "assets/ruankao-essay-writing/scripts/make-essay-doc.ps1",
    "locale",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "soft-exam",
    "ruankao",
    "essay",
    "skill"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zm886/dsh-ruankao-essay.git"
  },
  "homepage": "https://github.com/Zm886/dsh-ruankao-essay#readme",
  "bugs": {
    "url": "https://github.com/Zm886/dsh-ruankao-essay/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-skill": "*"
  }
}
